# Cloudflare Pages headers — © 2026 CCC Studio
# /assets/*: long browser cache OK for real files; no `immutable` on the wildcard
# so a mistaken HTML/404 under an asset URL cannot stick in CF edge forever.
/assets/*
  Cache-Control: public, max-age=86400, must-revalidate

# Plain-text AI/crawler map — never HTML
/llms.txt
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=0, must-revalidate

# Real favicon — not SPA HTML
/favicon.ico
  Cache-Control: public, max-age=604800

# HTML: always revalidate so a redeploy is picked up immediately
/*
  Cache-Control: public, max-age=0, must-revalidate
